+    private fun legacyMembershipDelta(
+        currentSymbols:List<String>,
+        previousSnapshots:List<List<String>>,
+        noOutgoingText:String
+    ):Pair<String,String> {
+        val current=currentSymbols.map { it.trim().uppercase() }.filter { it.isNotBlank() }.distinct().take(20)
+        if(current.size<20) return "—" to "—"
+        var newer=current
+        var oldest=current
+        var incoming:List<String>?=null
+        var outgoing:List<String>?=null
+        var previousFound=false
+        previousSnapshots.forEach { raw ->
+            val older=raw.map { it.trim().uppercase() }.filter { it.isNotBlank() }.distinct().take(20)
+            if(older.size<20) return@forEach
+            previousFound=true
+            val olderSet=older.toSet()
+            val newerSet=newer.toSet()
+            if(incoming==null) {
+                val x=newer.filterNot { it in olderSet }
+                if(x.isNotEmpty()) incoming=x
+            }
+            if(outgoing==null) {
+                val x=older.filterNot { it in newerSet }
+                if(x.isNotEmpty()) outgoing=x
+            }
+            oldest=older
+            newer=older
+        }
+        val gln=(incoming ?: if(previousFound) oldest else current)
+            .takeIf { it.isNotEmpty() }?.joinToString(" · ") ?: "Henüz değişiklik yok"
+        val gdn=outgoing?.takeIf { it.isNotEmpty() }?.joinToString(" · ") ?: noOutgoingText
+        return gln to gdn
     }
 
